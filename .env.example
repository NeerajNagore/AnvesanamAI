# Leave empty for demo mode. Set to your FastAPI base URL to go live.
# "/api" uses the Vite dev proxy (-> http://localhost:8000).
VITE_API_BASE_URL=/api
# VITE_BACKEND_URL=http://localhost:8000

# NEVER put API keys in this file. Keys (OPENAI_API_KEY, TAVILY_API_KEY, NEWSAPI_KEY,
# OPENWEATHER_API_KEY) belong in the Python backend's environment only.
