# Copy this file to .env and fill in your credentials.
# Keys can also be added later from the app's Integrations page.

# AI Provider (Groq) — https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Web Search — https://app.tavily.com
TAVILY_API_KEY=replace_with_your_tavily_api_key

# News Headlines (optional — GNews free tier is used when this is absent)
# https://gnews.io  or  https://newsapi.org/register
NEWSAPI_KEY=replace_with_your_gnews_or_newsapi_key

# Backend Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
NEWS_COUNTRY=in
DATA_DIR=.data
