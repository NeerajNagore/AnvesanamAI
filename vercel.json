{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/integrations/:id/test",
      "destination": "/api/integrations?id=$1&action=test"
    },
    {
      "source": "/api/integrations/:id",
      "destination": "/api/integrations?id=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
