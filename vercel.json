{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/integrations/:id/test",
      "destination": "/api/integrations/[id]/test"
    },
    {
      "source": "/api/integrations/:id",
      "destination": "/api/integrations/[id]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
